# Copy to keystore.properties and fill in. That file is gitignored — the
# passwords must never be committed.
#
# For personal builds TyBIT is signed with this machine's debug key, so a
# release build installs over the last one without losing app data:
#
#   storeFile=C:/Users/USER/.android/debug.keystore
#   storePassword=android
#   keyAlias=androiddebugkey
#   keyPassword=android
#
# A key of its own, if TyBIT is ever handed to anyone else:
#
#   keytool -genkey -v -keystore tybit-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias tybit

storeFile=tybit-release.jks
storePassword=
keyAlias=tybit
keyPassword=
